# Copy this file to .env and fill in your own values. Never commit .env.
CANVAS_ICS=https://example.instructure.com/feeds/calendars/REPLACE_ME.ics
ICLOUD_ICS=webcal://p00-caldav.icloud.com/published/2/REPLACE_ME

# Comma-separated list of absolute folders to watch and index.
# Defaults to the current user's Downloads and Documents folders when unset.
WATCHED_FOLDERS=

# Host/port for the local Flask server.
FILESORTER_HOST=127.0.0.1
FILESORTER_PORT=5000

# Global hotkey that opens the dashboard/app window (Windows only).
FILESORTER_HOTKEY=win+shift+f

# Path to the SQLite database file (defaults to server/data/filesorter.db).
FILESORTER_DB=

# Browser executable used for --app= window mode (Windows only).
FILESORTER_BROWSER=msedge
